rrorTitle:"請輸入標題",errorName:"請輸入暱稱",publish:"發布",saveSuccess:"已儲存排行範本",hint1:"若此排行範本為自用，沒有分享給其他玩家查看的打算，",hint2:"儲存方式請選擇本地儲存，以節省線上資料庫空間。若需要發佈範本，則建議",hint3:"使用帳號登入",hint4:"以利後續編輯修改。",hint5:"P.S. 本地儲存的範本將無法被分享，但仍可以從本地瀏覽及進行修改 / 刪除的操作，",hint6:"亦可以隨時將本地儲存的範本發佈到線上資料庫上。",hint7:"請注意，若在未登入狀態下發佈範本，後續將無法針對此範本進行任何修改及刪除操作。",hint8:"且為維持資料庫容量，系統將於60天後自動刪除此範本。",publishTemplate:"發布排行範本",publishSuccess:"發布成功！這是您的分享連結：",loginRequired:"請先登入以儲存到雲端",saveFailed:"儲存失敗，請稍後再試"},list:{title:"排行範本列表",empty:"尚無資料",createNew:"新增排行範本",localTemplates:"本地範本",cloudTemplates:"雲端範本",myTemplates:"我的排行範本",favorites:"已收藏排行範本",untitled:"未命名",tabs:{public:"公開列表",my:"我的排行範本",favorites:"已收藏排行"},sort:{newest:"最新",popular:"熱門"},hints:{tip_important:"本站僅提供「排行範本」編輯工具，所有內容均由使用者自行產出，不代表官方以及站方立場。考慮到遊戲機制具備高度複雜性，清單排名僅供參考，建議玩家依據實際戰鬥情境與自身需求進行評估。",tip_public:"瀏覽所有公開的排行範本，可按讚或收藏。",tip_local:"「本地範本」儲存於本地端瀏覽器上，故使用不同裝置或不同瀏覽器時可能會有資料相異的情況。",tip_cloud:"「雲端範本」儲存於雲端資料庫，可跨裝置存取。",tip_favorites:"「已收藏排行範本」儲存於本地瀏覽器，已登入用戶可將收藏列表備份至雲端資料庫，並在不同裝置間透過雲端讀取的方式存取收藏範本。",needLogin:"需先登入帳號，以查看本分類下項目。",nodata:"本分類下尚無任何範本。"},actions:{like:"按讚",unlike:"取消按讚",favorite:"收藏",unfavorite:"取消收藏",share:"分享",edit:"編輯",delete:"刪除",preview:"預覽"},table:{public:"公開",allowCollaborate:"協作",title:"標題",author:"作者",likes:"按讚數",createDate:"建立日期",updateDate:"更新日期",operation:"操作"},msgs:{deleteConfirm:"確定要刪除此排行範本嗎？",deleteSuccess:"已刪除。",deleteFailed:"刪除失敗，請稍後再試",copiedLink:"已複製分享連結！",loadFailed:"載入失敗，請稍後再試",updatePublicSuccess:"已更新公開狀態。",updatePublicFailed:"更新公開狀態失敗",updateAllowCollaborateSuccess:"已更新協作設定",updateAllowCollaborateFailed:"更新協作設定失敗"}},preview:{notFound:"找不到該範本",like:"喜歡",liked:"已喜歡",unliked:"已取消喜歡",likeFailed:"操作失敗，請稍後再試",favorite:"收藏",favorited:"已收藏",unfavorited:"已取消收藏",favoriteAdded:"已加入收藏",favoriteFailed:"操作失敗，請稍後再試"},selector:{selectedCharacters:"已選擇角色",noSelection:"點擊下方角色新增",removeItem:"移除"}},qF={overview:{title:"服裝總覽"},source:{bd2db:"BD2DB紀錄",bdx:"BDX紀錄"},bdx:{title:"BDX紀錄",globalTitle:"BDX全站統計",globalSummaryTitle:"{category} 全站統計",barTitle:"{category}