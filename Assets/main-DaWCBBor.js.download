rtBtnText:"支持本站",supportText:"因應PayPal贊助方式無法在台灣進行付款，暫時關閉此連結。<br>之後再找找看有沒有其他替代方式。",updateLogTitle:"網頁更新日誌",importantUpdate:"重要更新",aboutThisSite:"BD2DB是《棕色塵埃2》的非官方遊戲圖鑑網站，致力於為玩家提供最完整、最實用的遊戲資料。",aboutThisSite_2:"內容涵蓋角色、服裝、裝備、地圖、技能、煉製、收藏品等圖鑑資訊，並提供多種實用的計算器工具，例如副詞條配比計算、陣形範本等等，協助玩家快速查詢與優化戰略。"},gF={pageTitle:"角色列表",maxLevelStats:"滿等基礎數值",potentialLiberation:"潛力樹狀圖",bannerShopHistory:"Pickup/商店紀錄",costumeVideo:"服裝PV動畫",atk_position:"攻擊位置",knockback_position:"擊退方向",character_pass:"角色通行證",Held:"已進行",NotHeld:"未進行",abilityOverview:"能力值總覽",PermanentPotential:"共用潛力",BondingPotential:"綁定潛力",SkillPotential:"技能潛力",getWay:"取得方式",tarvern:"酒館招募",bannerHistory:"服裝Pickup記錄",shopHistory:"商店紀錄",profileTooltip:"簡介 / 台詞",profile:{profileText:"簡介",lineText:"台詞",age:"年齡",height:"身高",birthday:"生日",position:"所屬/職位",hobby:"興趣",like:"喜歡的東西",hate:"討厭的東西",cherish:"珍愛的東西",rumor1:"謠言1",rumor2:"謠言2"},skillHistory:"過往版本",skillHistoryTitle:"技能歷史",skillHistory_date:"日期",skillHistory_range:"範圍",skillHistory_level:"加值",skillHistory_skill:"技能描述",skillHistory_currentVersion:"當前版本",skillHistory_disclaimer:"部分過往技能數據係依據官方歷史公告整理，若發現內容有誤，歡迎至 Discord 提供正確資訊以協助修正。"},vF={pageTitle:"裝備列表",ExclusiveAbility:"專用能力",ExclusiveAbilityShort:"專用能力",BasicStat:"基本能力",OptionStat:"副詞條",ExclusiveGear:"專用裝備",MonsterGear:"魔獸裝備",CraftedGear:"製作裝備",ExclusiveShort:"專用裝備",MonsterShort:"魔獸裝備",CraftedShort:"製作裝備",GearLevel1:"一般",GearLevel2:"高級",GearLevel3:"頂級",GearLevel4:"傳說",GearTierR:"R",GearTierSR:"SR",GearTierUR:"UR",All_Part:"全部部位",Weapon_Part:"武器",Armor_Part:"盔甲",Helmet_Part:"頭盔",Gloves_Part:"手套",Jewelry_Part:"飾品",upgradeRank:"強化等級",quality:"裝備品質"},yF={pageTitle:"服裝列表",spCostTag:"SP消耗: ",chainTag:"連鎖: ",filterLogic:"篩選邏輯",filterLogicAnd:"AND",filterLogicOr:"OR",filterLogicAndDescription:"所有篩選條件都需符合",filterLogicOrDescription:"至少有一個篩選條件符合",groupTitle_special:"特殊標籤",groupTitle_commons:"常用標籤",groupTitle_damageTypes:"傷害類型",groupTitle_defenseAndRecovery:"回復/防禦類型",groupTitle_selfEffects:"套用於己方效果",groupTitle_enemyEffects:"套用於敵方效果",groupTitle_